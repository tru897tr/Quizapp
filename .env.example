# ===========================================================
#  QUIZ MASTER - CAU HINH MOI TRUONG (BIEN MOI TRUONG)
#  Sao chep file nay thanh ".env" roi dien gia tri that vao.
#  Lenh: cp .env.example .env
# ===========================================================

# ---- May chu ----
# Cong server se lang nghe. Tren Render KHONG duoc tu dat bien nay,
# Render se tu dong cap phat qua bien PORT co san.
PORT=3000

# Dia chi goc cua ung dung (dung de tao link trong email dat lai mat khau).
# Vi du khi chay o may ca nhan: http://localhost:3000
# Vi du khi da trien khai tren Render: https://ten-app-cua-ban.onrender.com
BASE_URL=http://localhost:3000

# Moi truong chay: development (phat trien) hoac production (san xuat)
NODE_ENV=development

# Bat/tat log chi tiet. true = ghi log day du, false = chi ghi loi quan trong.
DEBUG=true

# ---- Bao mat ----
# Chuoi bi mat dung de ky (sign) cookie va sinh token noi bo.
# BAT BUOC doi gia tri nay truoc khi dua len moi truong that.
# Co the tao nhanh bang lenh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=doi-chuoi-bi-mat-nay-truoc-khi-trien-khai

# Danh sach tai khoan (username) se tu dong duoc cap quyen Quan tri vien,
# cach nhau boi dau phay. Neu de trong, nguoi dang ky DAU TIEN se la admin.
ADMIN_USERNAMES=

# ---- Email (tuy chon - dung cho tinh nang quen mat khau) ----
# Tao App Password tai: https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=

# ---- Thong bao Discord (tuy chon) ----
# Webhook de nhan log/canh bao bao mat qua kenh Discord. De trong neu khong dung.
DISCORD_WEBHOOK=
